{
  "name": "abc-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "simulate": "tsx scripts/simulate.ts",
