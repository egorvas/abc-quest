    "voice:check": ".voice-cache/venv/bin/python scripts/voice/listen-check.py"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Interactive English alphabet trainer for kids"
